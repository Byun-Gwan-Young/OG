# 오피스지니 리버스 프록시. 도메인·메일은 .env.production에서 받는다(docker-compose.yml의 caddy environment).
# - 80/443만 외부에 열고, 웹(8501)·MCP(8000)는 Docker 내부 네트워크로만 연결한다.
# - 공인 도메인이면 Let's Encrypt 인증서를 자동으로 받고 갱신한다(인증서는 caddy_data 볼륨에 보관).
#   WEB_DOMAIN=localhost처럼 로컬 이름이면 Caddy 내부 인증서를 쓴다(로컬 확인용).
# - reverse_proxy는 웹소켓(Streamlit /_stcore/stream)을 그대로 통과시키고,
#   X-Forwarded-For / X-Forwarded-Proto(https) / X-Forwarded-Host를 붙인다. Host 헤더는 원래 값을 유지한다.
#   앱은 X-Forwarded-Proto로 로그인 쿠키 Secure와 https 주소를 정한다.
# - HTTP/3(QUIC, UDP 443)은 끈다. EC2 보안 그룹은 TCP 80/443만 열기 때문에, Caddy가 HTTP/3를 광고하면
#   (Alt-Svc: h3) 브라우저가 나중 요청(아이콘 폰트 등)을 막힌 UDP로 보내다 실패해 아이콘 이름 글자가 보였다.
#   Alt-Svc: clear로 브라우저가 기억한 HTTP/3 정보도 지운다.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

(common) {
	header Strict-Transport-Security "max-age=31536000"
	header Alt-Svc "clear"
}

{$WEB_DOMAIN} {
	import common
	encode zstd gzip
	reverse_proxy web:8501
}

{$MCP_DOMAIN} {
	import common
	# MCP Streamable HTTP(SSE) 응답은 버퍼링 없이 바로 흘려보낸다.
	reverse_proxy mcp:8000 {
		flush_interval -1
	}
}
