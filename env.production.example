# EC2 서버의 저장소 폴더에 .env.production 으로 복사해 값을 채운다. 이 파일(예시)만 저장소에 올린다.
#   cp env.production.example .env.production && chmod 600 .env.production && nano .env.production
# .env.production은 .gitignore·.dockerignore에 들어 있어 커밋·이미지에 포함되지 않는다.

# Neon main 브랜치 연결 주소 (비밀)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Jitda LLM API (비밀)
LLM_API_KEY=
LLM_BASE_URL=
# 회사 등록 가입 코드. 비우면 누구나 등록(시연용)
OFFICEGENIE_SIGNUP_CODE=
# 사원 홈 'AI 앱 연결' 카드와 MCP 안내 홈페이지에 보일 공개 주소 (https://<MCP_DOMAIN>)
OFFICEGENIE_MCP_PUBLIC_URL=https://mcp.example.com
# 운영 모드: DATABASE_URL이 없거나 SQLite면 시작 단계에서 멈춘다
OFFICEGENIE_ENV=production

# Caddy(HTTPS 자동 인증서). 두 도메인 모두 이 서버의 탄력적 IP를 가리켜야 한다.
WEB_DOMAIN=officegenie.example.com
MCP_DOMAIN=mcp.example.com
# Let's Encrypt 인증서 만료 안내를 받을 메일
ACME_EMAIL=admin@example.com
