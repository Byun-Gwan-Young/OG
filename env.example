# Jitda OpenAI-compatible API. Keep the real .env private and out of version control.
LLM_API_KEY=your-key-here
# Paste the API base URL from Jitda settings/docs (for example, the URL ending in /v1).
LLM_BASE_URL=

# Database (optional). Without DATABASE_URL the server uses local SQLite (./officegenie.db).
# Neon main branch connection string. Treat it as a secret; never commit the real value.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Test-only database (e.g. Neon dev branch). pytest never uses DATABASE_URL; must differ from it.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# SaaS sign-up. When set, the "회사 등록" screen requires this code. Leave unset for open demo sign-up.
# OFFICEGENIE_SIGNUP_CODE=choose-a-secret-code
# Seconds before other server processes pick up an admin upload (data_version check). Default 60.
# OFFICEGENIE_CACHE_TTL=60
